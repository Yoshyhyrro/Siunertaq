project Siunertaq is

   -- Configure root-level directory layout for source and compilation artifacts
   for Source_Dirs use ("src");
   for Object_Dir use "obj";

   -- Specify explicit entry points for execution targets
   for Main use ("contract_violation_demo.adb", "proof_target_demo.adb");

   package Builder is
      -- Enable parallel compilation across available cores
      for Switches ("Ada") use ("-j0");
   end Builder;

   package Compiler is
      -- Enforce strict Ada 2022 standards and style checks
      for Switches ("Ada") use ("-gnat2022", "-gnatwa", "-gnateF");
   end Compiler;

   package Prove is
      -- Establish semantic analysis and verification switches optimized for CVC5
      for Switches use ("--prover=cvc5", "--report=all");
   end Prove;

end Siunertaq;