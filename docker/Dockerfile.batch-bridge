# syntax=docker/dockerfile:1
#
# docker/Dockerfile.batch-bridge
#
# Runs io.siunertaq.batch.SiunertaqBatchApp: loads a BatchJob.dhall-defined
# job and executes it as Spring Batch steps (StackMachineTasklet) under
# Pekko supervision (JobSupervisorActor). No HTTP server anywhere in this
# module -- this is a one-shot batch process, meant for a k8s Job/CronJob,
# not a Deployment+Service.
#
# Packaging: NOT a fat jar. Pekko's config loading merges reference.conf
# from every jar on the classpath at class-load time; sbt-assembly-style
# fat jars need a MergeStrategy.concat rule for that specific file or
# Pekko silently loses config from whichever jar's reference.conf lost the
# merge collision. Keeping every dependency as its own jar on the
# classpath (stage 1 packages each into /out/lib, stage 2 runs with
# `-cp /app/lib/*`) sidesteps that entirely -- no merge step to get wrong.
#
# Classpath discovery: `sbt export .../Runtime/fullClasspath` asks sbt
# directly for the real, resolved classpath instead of guessing where
# compiled classes end up -- the same technique (and the same reason:
# guessing that path wrong cost several iterations) as
# .github/workflows/clojure_ci.yml's postgres-bridge job. See that
# workflow's inline history comments if this ever needs revisiting.

# ── Stage: perl (built from source) ─────────────────────────────────────────
# Builds the `perl` interpreter itself from source instead of
# `apt-get install perl`, using a modern GCC coaxed into accepting
# pre-ANSI, K&R-era C via an extensive compatibility flag set (confirmed
# working against GCC 16.2, and against source as old as Perl 3.0 (1989)
# as a stress test of the flag set's robustness --
# https://mirrors.develooper.com/perl/historical-perl/perl3.0.tar.gz --
# not because Perl 3 is the actual target: Siunertaq::StackMachine.pm
# needs Perl 5.6+ for JSON::PP as a core module, plus Perl-5-only syntax
# (my, references, the // defined-or operator from 5.10).
#
# No apt-installable GCC is old enough to compile genuinely ancient K&R C
# directly, and there's no prebuilt Perl archive for a source this old
# targeting a modern glibc -- the fix isn't an older compiler, it's
# telling a modern one to behave like one, flag by flag, below.
#
# Base image: NOT eclipse-temurin/ubuntu:22.04 (Jammy, glibc 2.35) --
# reproduced locally (gcc 13.3.0 / glibc 2.39) and confirmed the exact
# reported failure is caused specifically by -traditional-cpp, isolated
# by testing the full flag set with only that one flag removed (builds
# clean) vs. -traditional-cpp alone against a bare `#include <stdio.h>`
# (fails identically). Root cause: glibc's own features.h defines
# `#define __GLIBC_USE(F) __GLIBC_USE_ ## F` and calls it unconditionally
# from every standard header via `#if __GLIBC_USE (...)` -- traditional
# (pre-ANSI) cpp doesn't understand `##` in a #if expression at all, so
# this can't be worked around with more flags; it's a hard incompatibility
# between -traditional-cpp and this glibc's own headers, not a flag
# tuning problem. Bisected against real glibc release tags
# (github.com/bminor/glibc) to find exactly where this landed:
# __GLIBC_USE is absent through glibc 2.24, present from 2.25 (Feb 2017)
# on -- confirmed clean in both features.h and sys/cdefs.h through 2.24,
# not just grep-absent-by-name. ubuntu:16.04 ships glibc 2.23, safely on
# the clean side of that line.
#
# This means stage 2's eclipse-temurin:17-jre-jammy (glibc 2.35) and this
# stage's glibc (2.23) are now deliberately DIFFERENT versions, not
# matched the way an earlier version of this comment argued for -- that
# reasoning was backwards. glibc's own compatibility guarantee only runs
# one direction (a binary linked against an older glibc runs fine against
# a newer one; the reverse doesn't hold), so building perl-legacy against
# the oldest glibc that still compiles is the same direction that
# guarantee already points, and stage 2 copying it out and running it
# under a newer glibc is exactly the supported case, not a mismatch.
#
# NOT verified beyond this: ubuntu:16.04 is EOL, so its default apt
# sources 404 without the old-releases.ubuntu.com redirect below --
# that redirect is the standard, well-documented fix for this, but this
# sandbox has no reachable path to old-releases.ubuntu.com to confirm it
# still resolves correctly today. If ubuntu:16.04's image itself has
# been pulled from Docker Hub entirely by the time this runs, Debian 9
# "stretch" (glibc 2.24 -- confirmed clean above, right at the boundary
# rather than comfortably inside it) is the fallback candidate, with the
# equivalent archive.debian.org redirect.
FROM ubuntu:16.04 AS perl-legacy

# TODO: pin this to whichever Perl 5.x release is actually meant to ship
# here. 5.44.0 is current stable as of this writing and satisfies
# Siunertaq::StackMachine.pm's real requirements -- confirm before this
# replaces the apt package below. perl3.0.tar.gz above is the known-
# working stress test of the CFLAGS, not a real candidate for this ARG.
ARG PERL_SRC_URL=https://www.cpan.org/src/5.0/perl-5.44.0.tar.gz
ARG PERL_PREFIX=/usr/local/perl-legacy
# CC as its own ARG (promoted to ENV below), not hardcoded, in case this
# ends up needing a newer compiler than whatever ubuntu:16.04's own apt
# repos resolve `gcc`/build-essential to (gcc 5.x) -- e.g. via a PPA, if
# gcc 5 turns out to choke on something the working recipe's GCC 16.2
# didn't. Nothing below has been tested against gcc 5 specifically.
ARG CC=gcc

# EOL redirect: ubuntu:16.04's baked-in sources.list points at
# archive.ubuntu.com/security.ubuntu.com, which stop serving Xenial once
# it ages out of standard support -- old-releases.ubuntu.com is
# Canonical's documented long-term archive for exactly this. Ubuntu
# codename is xenial; adjust if the fallback (Debian 9 "stretch") is used
# instead, whose equivalent is archive.debian.org.
RUN sed -i \
      -e 's|http://archive.ubuntu.com/ubuntu|http://old-releases.ubuntu.com/ubuntu|g' \
      -e 's|http://security.ubuntu.com/ubuntu|http://old-releases.ubuntu.com/ubuntu|g' \
      /etc/apt/sources.list \
    && apt-get update && apt-get install -y --no-install-recommends \
      build-essential curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
ENV CC=${CC}

# Compatibility CFLAGS, transcribed verbatim from the working recipe --
# but with cppstdin/byteorder/charsprintf split back out (see the RUN
# step below for why). Do not "clean up" what's left here without
# re-testing against the oldest source it needs to build -- several of
# these exist specifically because a modern GCC default silently breaks
# old, valid-at-the-time C (most notably -fcommon: GCC 10 flipped the
# default to -fno-common, which breaks legacy code relying on tentative
# definitions of the same global variable across multiple files), rather
# than because of a diagnostic that's safe to just silence.
#
# -fpermissive triggers "valid for C++/ObjC++ but not for C" from cc1 on
# every compile -- confirmed benign (a no-op warning, not a build
# failure), left in as given rather than removed unilaterally.
ENV CFLAGS='-std=c90 -traditional-cpp -fcommon -fpermissive -O0 -ffreestanding -fpack-struct=4 -fno-strict-aliasing -fno-short-enums -fno-align-functions -fno-align-labels -fno-align-loops -fno-align-jumps -fno-jump-tables -fno-thread-jumps -fno-crossjumping -fno-gcse -Wno-builtin-declaration-mismatch -DMEMCPY -Dstrchr=index -Dstrrchr=rindex'

WORKDIR /src

# Historical tarballs don't reliably nest a single top-level directory the
# way modern ones do; extract into an empty directory and cd into
# whatever's there rather than assuming --strip-components=1 is correct.
RUN mkdir -p /src/perl-src \
    && curl -fsSL -o /tmp/perl-src.tar.gz "${PERL_SRC_URL}" \
    && tar -xf /tmp/perl-src.tar.gz -C /src/perl-src \
    && rm /tmp/perl-src.tar.gz

# -des: accept every Configure prompt's default, non-interactively.
#
# cppstdin/byteorder/charsprintf are passed as their own Configure
# -Dname=value arguments (Configure's *own* -D convention for presetting
# a config.sh variable -- unrelated to, despite the identical spelling,
# gcc's -D preprocessor-macro flag) rather than folded into -Dccflags
# above. The first attempt embedded -DCPPSTDIN="gcc -E" inside the
# ccflags string itself; whatever consumes ccflags downstream splits on
# whitespace with no awareness of the quote characters, so "gcc and -E"
# arrived at the real gcc invocation as two broken tokens (gcc: error:
# unrecognized command-line option '-E"'). -Dcppstdin='gcc -E' passed
# directly on this command line is parsed once, correctly, by *this*
# shell before Configure ever sees it, so the embedded space survives.
#
# TODO: cppstdin/byteorder/charsprintf were part of the flag set
# confirmed against perl3.0.tar.gz specifically -- not yet confirmed
# whether Perl 5.44.0's own Configure needs any of these three
# overridden at all (it may auto-probe correct values on a standard
# glibc/x86_64 or arm64 target without help). If this still fails with
# these three included, try dropping all three -D/-U lines below entirely
# before troubleshooting further. Also unconfirmed: whether the real
# Configure variable for "does sprintf return char*" is actually spelled
# d_charsprintf -- that one's a best guess, not a verified name.
#
# NOT verified end-to-end in CI as of this Dockerfile being written --
# this sandbox has no reachable path to mirrors.develooper.com or
# www.cpan.org to test-build against. Confirm this actually goes green
# (in particular: whether `make test` should run at all for the real
# target release -- currently skipped rather than guessed at) before it
# replaces the apt package below.
RUN cd /src/perl-src/*/ 2>/dev/null || cd /src/perl-src; \
    ./Configure -des \
      -Dprefix="${PERL_PREFIX}" \
      -Dcc="${CC}" \
      -Dccflags="${CFLAGS}" \
      -Dcppstdin='gcc -E' \
      -Dbyteorder=01234567 \
      -Ud_charsprintf && \
    make && \
    make install

# ── Stage 1: build ───────────────────────────────────────────────────────────
FROM eclipse-temurin:17-jdk-jammy AS build

# sbt via its official apt repo. The `sbt` binary itself only needs to be
# *a* working launcher -- it bootstraps the exact version pinned in
# project/build.properties (1.12.11) on first invocation, the same way
# GitHub Actions' sbt/setup-sbt does. Pinning the apt package version here
# would be redundant and another thing to keep in sync for no benefit.
RUN apt-get update && apt-get install -y --no-install-recommends \
      curl gnupg ca-certificates \
    && echo "deb https://repo.scala-sbt.org/scalasbt/debian all main" \
         | tee /etc/apt/sources.list.d/sbt.list \
    && curl -sL "https://keyserver.ubuntu.com/pks/lookup?op=get&search=0x2EE0EA64E40A89B84B2DF73499E82A75642AC823" \
         | gpg --dearmor | tee /etc/apt/trusted.gpg.d/sbt.gpg > /dev/null \
    && apt-get update && apt-get install -y --no-install-recommends sbt \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src

# Only the three modules this image needs (build.sbt's other lazy vals --
# z3-bridge, yices-bridge, postgres-bridge, petersen-mzv -- are untouched
# source on disk here, but sbt only resolves/compiles what batchBridge
# actually depends on: core and dhallBridge).
COPY project project
COPY build.sbt .
COPY modules/core modules/core
COPY modules/dhall-bridge modules/dhall-bridge
COPY modules/batch-bridge modules/batch-bridge

RUN sbt batchBridge/compile

# Longest-line extraction, not last-line: confirmed in clojure_ci.yml's
# own history that sbt can still emit a stray trailing line (an ANSI
# remnant, "[0J") even with supershell disabled, and the classpath --
# dozens of colon-separated jar paths -- is always far longer than any
# such line. sed strips any escape codes that survive onto the line
# itself as a second line of defense.
RUN sbt -Dsbt.supershell=false --error \
      'export batchBridge/Runtime/fullClasspath' \
      | awk '{ if (length($0) > length(longest)) longest = $0 } END { print longest }' \
      | sed 's/\x1b\[[0-9;]*[A-Za-z]//g' \
      > /tmp/classpath.txt \
    && test -s /tmp/classpath.txt \
    && grep -q "batch-bridge" /tmp/classpath.txt

# Every classpath entry becomes a jar under /out/lib: dependency jars are
# copied as-is, and each module's own compiled-classes *directory* (not a
# jar -- sbt's own build output) gets zipped with the JDK's own `jar`
# tool. This keeps every entry in /out/lib uniformly a .jar file, which
# matters because the JVM's `-cp dir/*` wildcard (used in stage 2) only
# expands to *.jar in that directory -- it does not pick up subdirectories,
# so leaving compiled-classes directories un-jarred here would silently
# drop this module's own code from the runtime classpath.
RUN mkdir -p /out/lib && i=0 && \
    tr ':' '\n' < /tmp/classpath.txt | while read -r entry; do \
      if [ -d "$entry" ]; then \
        i=$((i + 1)); \
        jar --create --file "/out/lib/local-$i.jar" -C "$entry" . ; \
      else \
        cp "$entry" /out/lib/ ; \
      fi \
    done

# ── Stage 2: runtime ─────────────────────────────────────────────────────────
FROM eclipse-temurin:17-jre-jammy

# StackMachine.pm ships as a classpath resource inside batch-bridge's own
# compiled classes (extracted to a temp file at runtime -- see
# PerlBridge.scala's "classpath resource" section) -- only the `perl`
# interpreter itself needs to be on PATH, no separate module install.
# PerlBridge.maybeCheckIO is gated on RUN_PERL_CROSSCHECK=1 (unset by
# default), so having perl installed here doesn't make every run pay for
# a Perl subprocess -- it makes the crosscheck available when a Job
# explicitly opts in via env var.
#
# perl itself now comes from the perl-legacy stage above (built from
# source) rather than apt-get install perl -- see that stage's header for
# why. Only its bin/ needs to be on PATH; nothing else in this stage
# depends on how it got there.
#
# dhall-to-json: SiunertaqBatchApp calls DhallBatchRegistry.
# loadBatchJobFromFile -> evalDhall at runtime, which shells out to this
# binary, exactly the same as PostgresBridgeApp (Dockerfile.postgres-
# bridge) -- this was missing from an earlier version of this Dockerfile
# (caught while writing podci.yml's smoke test, not by running this
# image, so treat it as unverified until that workflow actually goes
# green).
# Install bzip2 along with curl to support tar -xj extraction
RUN apt-get update && apt-get install -y --no-install-recommends \
      curl \
      bzip2 \
    && curl -sSL https://github.com/dhall-lang/dhall-haskell/releases/download/1.41.2/dhall-json-1.7.11-x86_64-Linux.tar.bz2 \
       | tar -xj -C /usr/local/bin --strip-components=1 bin/dhall-to-json \
    && apt-get purge -y curl && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --create-home --home-dir /app siunertaq

COPY --from=perl-legacy /usr/local/perl-legacy /usr/local/perl-legacy
ENV PATH="/usr/local/perl-legacy/bin:${PATH}"

WORKDIR /app
COPY --from=build /out/lib /app/lib
USER siunertaq

# BATCH_JOB_DHALL: SiunertaqBatchApp.scala reads this env var for which
# Dhall file to load via a plain filesystem Paths.get (not a classpath-
# resource lookup) -- its default
# ("modules/dhall-bridge/src/main/resources/BatchJob.dhall") is a
# repo-root-relative path that doesn't exist in this flattened runtime
# image, so BATCH_JOB_DHALL must always be set explicitly here (there is
# no working fallback). Point it at a ConfigMap-mounted file -- see
# k8s/configmap-batch-job.yaml and k8s/job-batch-bridge.yaml.
ENTRYPOINT ["java", "-cp", "/app/lib/*", "io.siunertaq.batch.SiunertaqBatchApp"]