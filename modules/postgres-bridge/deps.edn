;; modules/postgres-bridge/deps.edn
{:paths ["src/main/clojure"]
 :mvn/repos {"clojars" {:url "https://repo.clojars.org/"}}
 :deps {}

 :aliases
 {;; Runs the clojure.test namespaces under test/main/clojure via
  ;; cognitect-labs/test-runner (see modules/dhall-bridge/deps.edn for
  ;; the same pattern -- cognitect-labs/test-runner is only published
  ;; via git, not Maven Central).
  :test
  {:extra-paths ["test/main/clojure"]
   :extra-deps {org.clojure/test.check {:mvn/version "1.1.0"}
                io.github.cognitect-labs/test-runner
                {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
   :exec-fn cognitect.test-runner.api/test}

  ;; mecrisp-instr-test's real-interop variant (see that file's header)
  ;; needs io.siunertaq.postgres.MecrispInstr's *compiled* classes on
  ;; the classpath. Point this at wherever this module's Scala build
  ;; emits them (e.g. a sbt `Compile / classDirectory`, or a published
  ;; jar) -- adjust the path below to match the real build output.
  :scala-classes
  {:extra-paths ["target/scala-3.x/classes"]}}}