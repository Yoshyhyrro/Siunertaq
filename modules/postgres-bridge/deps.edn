;; modules/postgres-bridge/deps.edn
{:paths ["src/main/clojure"]
 :mvn/repos {"clojars" {:url "https://repo.clojars.org/"}}
 :deps {}

 :aliases
 {;; Runs the clojure.test namespaces under test/main/clojure via
  ;; cognitect-labs/test-runner (see modules/dhall-bridge/deps.edn for
  ;; the same pattern -- cognitect-labs/test-runner is only published
  ;; via git, not Maven Central).
  :test
  {:extra-paths ["test/main/clojure"]
   :extra-deps {org.clojure/test.check {:mvn/version "1.1.0"}
                io.github.cognitect-labs/test-runner
                {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
   :exec-fn cognitect.test-runner.api/test}

  ;; Real JVM interop into this module's compiled Scala classes (used by
  ;; compilation-wiring-test.clj; mecrisp-instr-test.clj's header
  ;; describes the same need but still uses a transcribed model).
  ;;
  ;; Run `sbt postgresBridge/compile` first, then
  ;; `clojure -X:test:scala-classes` from this directory.
  ;;
  ;; target/scala-3/classes: build.sbt pins scalaVersion to 3.8.3, and
  ;; sbt's crossTarget for any Scala 3.x is always "scala-3" (Scala 3
  ;; guarantees binary compatibility across all 3.x minor versions under
  ;; one major version) -- not "scala-3.x" as a literal path, and not
  ;; "scala-3.8". Confirm against `sbt postgresBridge/classDirectory` if
  ;; this ever needs to change.
  ;;
  ;; org.scala-lang/scala3-library_3: the compiled classes above use
  ;; scala.Option/Tuple2/Vector etc., which live in the Scala standard
  ;; library, not in this project's own target/ directory -- without it,
  ;; loading io.siunertaq.postgres.MecrispCompiler fails with
  ;; NoClassDefFoundError before any test body even runs. Pinned to the
  ;; same version as ThisBuild / scalaVersion in build.sbt so the
  ;; standard library on this classpath always matches what
  ;; postgresBridge was actually compiled against.
  ;;
  ;; MecrispCompiler/MecrispWordDef/MecrispInstr/BytecodeRow/ClassFileHash
  ;; depend on nothing beyond the Scala standard library, so this is
  ;; sufficient for compilation-wiring-test.clj. ClassASTBridge.scala and
  ;; ClickHouseSync.scala additionally need cats-effect/circe/pekko on
  ;; the classpath, which this alias does not attempt to provide yet.
  :scala-classes
  {:extra-paths ["target/scala-3/classes"]
   :extra-deps {org.scala-lang/scala3-library_3 {:mvn/version "3.8.3"}}}}}